#!/bin/sh
# The one place this plugin decides which interpreter runs its Python.
#
# Call sites (skills, hooks) name THIS file, never `uv` and never an
# interpreter, so the resolution order below is changed once rather than at
# every invocation. That indirection is the whole point: the previous design
# repeated `uv run --no-project` across nine surfaces, so the machine-dependent
# half of the decision was invisible until it failed on someone else's laptop.
#
# Resolution order:
#   1. uv, which resolves the operator's own pin -- a repo's .python-version
#      first, then `uv python pin --global`. Deliberately NOT `--python X.Y`:
#      an operator who pinned an interpreter meant it.
#   2. Failing that, a system interpreter new enough to parse this plugin's
#      code, plus a nudge toward uv on stderr.
#   3. Failing that, a diagnosis -- never a SyntaxError traceback.
#
# The floor is real, not defensive: this plugin is formatted by black at
# target py314, which emits PEP 758 `except A, B:`. An older interpreter does
# not run this code badly, it refuses to parse it. So a fallback below the
# floor is not a degraded mode, it is a crash with extra steps -- step 3 says
# so in words the operator can act on.
set -eu

MINIMUM_VERSION="3.14"
UV_INSTALL_URL="https://docs.astral.sh/uv/getting-started/installation/"

# Why the uv path was not taken, so the fallback notice states the real reason
# rather than a guess. "uv not found" printed on a machine that has uv (and
# merely resolved an interpreter below the floor) sends the operator to install
# something they already have.
uv_skip_reason="uv not found"

# The floor is interpolated rather than repeated as a literal tuple: two copies
# of "3.14" in one file is one copy too many, and the stale one would be the
# check rather than the message.
version_check_source() {
    printf '%s' "import sys; raise SystemExit(0 if sys.version_info[:2] >= tuple(
        int(part) for part in '$MINIMUM_VERSION'.split('.')) else 1)"
}

meets_minimum() {
    "$1" -c "$(version_check_source)" >/dev/null 2>&1
}

uv_meets_minimum() {
    uv run --no-project python -c "$(version_check_source)" >/dev/null 2>&1
}

# uv is preferred, but only when what it resolves actually clears the floor.
# `uv run --no-project python` honours the operator's pin, and a repo pinned
# below the floor by its own .python-version is ordinary -- this plugin's hooks
# run inside whatever repo the operator happens to be in. Exec'ing blind there
# handed PEP 758 source to an interpreter that cannot parse it, so every
# session start in such a repo printed a SyntaxError traceback: precisely the
# failure step 3 exists to replace with a diagnosis.
#
# The check runs through `uv run --no-project python` itself rather than
# `uv python find`, so what is tested is the exact resolution the exec below
# will use -- not a second query that could disagree with it. If it clears,
# exec uv as before. If not, fall through: the loop below may still find a
# system interpreter that does, and failing that the operator gets the
# diagnosis instead of a traceback.
if command -v uv >/dev/null 2>&1; then
    if uv_meets_minimum; then
        exec uv run --no-project python "$@"
    fi
    uv_skip_reason="uv resolves an interpreter older than $MINIMUM_VERSION here"
    printf '%s\n' \
        "mente-apex: $uv_skip_reason." \
        "  A .python-version in this directory pins it below what this plugin parses." \
        "  Run 'uv python pin $MINIMUM_VERSION' here, or install a newer system Python." \
        >&2
fi

for candidate in python3.14 python3 python; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    meets_minimum "$candidate" || continue
    printf '%s\n' \
        "mente-apex: $uv_skip_reason; falling back to $candidate." \
        "  Install uv so this plugin runs on your pinned interpreter: $UV_INSTALL_URL" \
        >&2
    exec "$candidate" "$@"
done

printf '%s\n' \
    "mente-apex: no usable Python found." \
    "  This plugin requires Python >= $MINIMUM_VERSION; every interpreter on PATH is older." \
    "  Install uv and it will fetch a suitable one: $UV_INSTALL_URL" \
    >&2
exit 1
